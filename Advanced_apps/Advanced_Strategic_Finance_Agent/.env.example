# Required API Keys — copy this file to .env and fill in your keys
# Never commit .env to version control (already in .gitignore)

# Google GenAI API Key — powers Gemini 3.1 Flash Lite reasoning
GOOGLE_API_KEY=your_google_api_key_here

# ExchangeRate API Key — primary FX data source (free at https://www.exchangerate-api.com/)
EXCHANGERATE_API_KEY=your_exchangerate_api_key_here

# Tavily Search API Key — AI-native market intelligence (free tier at https://tavily.com/)
TAVILY_API_KEY=your_tavily_api_key_here