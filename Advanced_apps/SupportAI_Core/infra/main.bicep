// SupportAI Core — Azure Container Apps Infrastructure
// Generated by azure-prepare for consumption plan (scale-to-zero, $0 within free tier)

targetScope = 'subscription'

@minLength(1)
@maxLength(64)
param name string = 'supportai-core'

@minLength(1)
@maxLength(128)
param location string = 'southeastasia'

param environmentName string = 'prod'

// Resource naming with standardized prefix
var resourceToken = uniqueString(subscription().id, environmentName, location)
var resourcePrefix = '${name}${resourceToken}'

// ─── Resource Group ───
resource rg 'Microsoft.Resources/resourceGroups@2023-07-01' = {
  name: '${name}-${environmentName}-rg'
  location: location
}

// ─── Log Analytics Workspace (required by Container Apps Environment) ───
module logAnalytics './modules/log-analytics.bicep' = {
  name: 'logAnalytics'
  scope: rg
  params: {
    name: '${resourcePrefix}-law'
    location: location
  }
}

// ─── Container Apps Environment ───
module containerAppsEnvironment './modules/container-apps-environment.bicep' = {
  name: 'containerAppsEnvironment'
  scope: rg
  params: {
    name: '${resourcePrefix}-env'
    location: location
    logAnalyticsWorkspaceId: logAnalytics.outputs.workspaceId
    logAnalyticsSharedKey: logAnalytics.outputs.workspaceSharedKey
  }
}

// ─── Azure Container Registry (for Docker image storage) ───
module containerRegistry './modules/container-registry.bicep' = {
  name: 'containerRegistry'
  scope: rg
  params: {
    name: replace('cr${resourcePrefix}', '-', '')
    location: location
  }
}

// ─── Container App — Phase 1 (placeholder image, no registry link yet) ───
module api './modules/container-app.bicep' = {
  name: 'api'
  scope: rg
  params: {
    appName: '${resourcePrefix}-app'
    location: location
    containerAppsEnvironmentId: containerAppsEnvironment.outputs.environmentId
    containerImageName: 'mcr.microsoft.com/azuredocs/containerapps-helloworld:latest'
    serviceName: 'supportai-core'
    envVars: [
      { name: 'PINECONE_API_KEY', value: 'placeholder' }
      { name: 'ZEN_API_KEY', value: 'placeholder' }
      { name: 'LANGCHAIN_TRACING_V2', value: 'false' }
    ]
  }
}

// ─── ACR Pull Role Assignment — Phase 2 (no circular dependency) ───
module acrPullRole './modules/acr-pull-role.bicep' = {
  name: 'acrPullRole'
  scope: rg
  params: {
    acrName: containerRegistry.outputs.name
    principalId: api.outputs.systemAssignedMIPrincipalId
  }
}

// ─── Outputs ───
output APP_URL string = api.outputs.appUrl
output ACR_NAME string = containerRegistry.outputs.name
output ACR_LOGIN_SERVER string = containerRegistry.outputs.loginServer
output RESOURCE_GROUP string = rg.name
